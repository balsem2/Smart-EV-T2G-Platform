# Copy this file to backend/.env and replace the placeholders locally.
# Never commit the real password.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/balsem_smart_ev
APP_NAME=Smart EV API
APP_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
STATION_API_KEY=replace-with-a-private-station-key
# Register a public API key at https://admin.ladestellen.at/#/api/registrieren
# Use the exact domain registered with E-Control for the Referer value.
ECONTROL_API_KEY=
ECONTROL_REFERER=
FRONTEND_URL=http://smart-ev.localhost:5173
# Stripe test key (starts with sk_test_). Leave empty to use local academic checkout.
STRIPE_SECRET_KEY=
# Optional LLM chatbot. Create the key at https://platform.openai.com/api-keys.
# Leave it empty to keep the verified local knowledge-base fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=20
# Local demo SMTP: run `python -m scripts.local_mail_server`, then open http://localhost:8025.
# Replace these values with your provider settings only for a deployed environment.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@smart-ev.local
SMTP_USE_TLS=false
